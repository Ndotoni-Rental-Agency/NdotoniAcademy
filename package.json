{
  "name": "taa-prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "amplify:statements": "pnpm amplify codegen statements",
    "amplify:types": "pnpm amplify codegen types",
    "amplify:codegen": "pnpm run amplify:statements && pnpm run amplify:types",
    "schema:download": "aws appsync get-introspection-schema --api-id c6jv3b3bqfhmlf2penfjstnt5i --region us-west-2 --profile beta --format SDL schema.graphql",
    "schema:clean": "node scripts/clean-schema.js",
    "schema:generate": "pnpm run amplify:codegen",
    "schema:update": "pnpm run schema:download && pnpm run schema:clean && pnpm run schema:generate"
  },
  "dependencies": {
    "aws-amplify": "^6.20.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@aws-amplify/cli": "^14.5.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
